            (auth)
_arguments "${_arguments_options[@]}" : \
":: :_koushin__subcmd__help__subcmd__auth_commands" \
"*::: :->auth" \
&& ret=0

    case $state in
    (auth)
        words=($line[1] "${words[@]}")
